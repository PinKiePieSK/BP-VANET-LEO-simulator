 {
@@ -99,6 +103,15 @@ SatChannel::GetTypeId (void)
                     BooleanValue (false),
                     MakeBooleanAccessor (&SatChannel::m_enableRxPowerOutputTrace),
                     MakeBooleanChecker ())
+    .AddAttribute ("MinElevationAngleDeg",
+                   "Native channel cutoff at the ground endpoint; -90 disables it.",
+                   DoubleValue (-90.0),
+                   MakeDoubleAccessor (&SatChannel::m_minElevationAngleDeg),
+                   MakeDoubleChecker<double> (-90.0, 90.0))
+    .AddTraceSource ("EarthOccultationDrop",
+                     "Signal refused by the native satellite channel below the elevation mask.",
+                     MakeTraceSourceAccessor (&SatChannel::m_earthOccultationDropTrace),
+                     "ns3::TracedCallback::Double")
     .AddAttribute ( "EnableFadingOutputTrace",
                     "Enable fading output trace.",
                     BooleanValue (false),
@@ -273,6 +286,43 @@ SatChannel::ScheduleRx (Ptr<SatSignalParameters> txParams, Ptr<SatPhyRx> receive
   Ptr<MobilityModel> senderMobility = txParams->m_phyTx->GetMobility ();
   Ptr<MobilityModel> receiverMobility = receiver->GetMobility ();
 
+  if (m_minElevationAngleDeg > -90.0)
+    {
+      const bool groundSender = m_channelType == SatEnums::RETURN_USER_CH ||
+                                m_channelType == SatEnums::FORWARD_FEEDER_CH;
+      const bool groundReceiver = m_channelType == SatEnums::FORWARD_USER_CH ||
+                                  m_channelType == SatEnums::RETURN_FEEDER_CH;
+      if (groundSender || groundReceiver)
+        {
+          Ptr<SatMobilityModel> ground = DynamicCast<SatMobilityModel> (
+              groundSender ? senderMobility : receiverMobility);
+          Ptr<SatMobilityModel> satellite = DynamicCast<SatMobilityModel> (
+              groundSender ? receiverMobility : senderMobility);
+          NS_ABORT_MSG_IF (!ground || !satellite,
+                           "Satellite elevation mask requires geodetic mobility models");
+          const GeoCoordinate site = ground->GetGeoPosition ();
+          const Vector siteEcef = ground->GetPosition ();
+          const Vector satEcef = satellite->GetPosition ();
+          const double lat = SatUtils::DegreesToRadians (site.GetLatitude ());
+          const double lon = SatUtils::DegreesToRadians (site.GetLongitude ());
+          const double dx = satEcef.x - siteEcef.x;
+          const double dy = satEcef.y - siteEcef.y;
+          const double dz = satEcef.z - siteEcef.z;
+          const double distance = std::sqrt (dx * dx + dy * dy + dz * dz);
+          NS_ABORT_MSG_IF (!(distance > 0.0), "Satellite elevation distance invalid");
+          const double up = (dx * std::cos (lat) * std::cos (lon) +
+                             dy * std::cos (lat) * std::sin (lon) +
+                             dz * std::sin (lat)) / distance;
+          const double elevation = SatUtils::RadiansToDegrees (
+              std::asin (std::max (-1.0, std::min (1.0, up))));
+          if (elevation < m_minElevationAngleDeg)
+            {
+              m_earthOccultationDropTrace (elevation);
+              return;
+            }
+        }
+    }
+
   NS_LOG_INFO ("copying signal parameters " << txParams);
   Ptr<SatSignalParameters> rxParams = txParams->Copy ();
 
