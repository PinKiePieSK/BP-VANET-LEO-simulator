+void
+SatUtPhy::PerformSatelliteHandover (uint32_t satId, uint32_t beamId)
+{
+  NS_LOG_FUNCTION (this << satId << beamId);
+  SatChannelPair::ChannelPair_t oldChannels = m_retrieveChannelPair (m_satId, m_beamId);
+  m_phyTx->ClearChannel ();
+  oldChannels.first->RemoveRx (m_phyRx);
+  SetSatId (satId);
+  SetBeamId (beamId);
+  Simulator::Schedule (m_antennaReconfigurationDelay, &SatUtPhy::AssignNewSatChannels, this);
+}
